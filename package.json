{
  "name": "citynode.app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "bos": "bos",
    "dev": "bos dev",
    "build": "bos build",
    "deploy": "bos deploy",
    "publish": "bos publish",
    "start": "bos start",
    "typecheck": "pnpm run types:gen && pnpm run gen:auth-ui && if [ -d ui ]; then pnpm --dir ui run typecheck; fi && if [ -d api ]; then pnpm --dir api run typecheck; fi && if [ -d plugins ]; then for dir in plugins/*; do if [ -f \"$dir/package.json\" ]; then pnpm --dir \"$dir\" --if-present run typecheck || exit 1; pnpm --dir \"$dir\" --if-present run typecheck:ui || exit 1; fi; done; fi",
    "test": "pnpm --dir api --if-present run test && pnpm --dir ui --if-present run test && for d in plugins/*; do [ -f \"$d/package.json\" ] && pnpm --dir \"$d\" --if-present run test; done",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "version": "changeset version",
    "db:push": "pnpm --dir api exec drizzle-kit push",
    "db:studio": "bos db:studio",
    "db:generate": "pnpm --dir api exec drizzle-kit generate",
    "db:migrate": "pnpm --dir api exec drizzle-kit migrate",
    "dev:postgres": "docker compose up -d --wait && pnpm run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait",
    "dev:proxy": "bos dev --proxy",
    "release": "echo 'Packages versioned - app release handled by workflow'",
    "types:gen": "bos types gen",
    "db:doctor": "bos db:doctor",
    "db:repair": "bos db:repair",
    "test:api": "pnpm --dir api --if-present run test",
    "test:integration": "pnpm --dir api --if-present run test tests/integration/",
    "test:db:up": "docker compose up -d --wait postgres-api-test postgres-auth-test",
    "test:db:reset": "docker compose rm -fsv postgres-api-test postgres-auth-test && docker compose up -d --wait postgres-api-test postgres-auth-test",
    "test:regression:unit": "node --test tests/regression/lib/*.test.mjs",
    "test:regression:browser:install": "pnpm exec playwright install --with-deps chromium",
    "test:regression:browser:dev:ssr": "node tests/regression/lib/preflight.mjs && REGRESSION_MODE=dev:ssr pnpm exec playwright test -c tests/regression/browser/playwright.config.mjs --project=dev:ssr",
    "test:regression:browser": "pnpm run test:regression:browser:dev:ssr",
    "regression:dev:ssr": "node tests/regression/lib/start-stack.mjs dev:ssr",
    "dev:ui": "bos dev --ui local --api remote",
    "dev:api": "bos dev --ui remote --api local",
    "gen:auth-ui": "node scripts/gen-auth-ui-artifacts.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.8",
    "@effect/tsgo": "^0.45.0",
    "@playwright/test": "^1.58.1",
    "@shadcn/lint": "^0.2.0",
    "@types/pg": "catalog:",
    "dotenv": "^17.3.1",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@effect/oxc": "link:repos/effect/packages/tools/oxc",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "catalog:",
    "@opentelemetry/api": "catalog:"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  }
}
