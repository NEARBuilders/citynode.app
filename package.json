{
  "name": "citynode.app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "bos": "bos",
    "dev": "bos dev",
    "build": "bos build",
    "deploy": "bos deploy",
    "publish": "bos publish",
    "start": "bos start --no-interactive",
    "typecheck": "bos typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "changeset": "changeset",
    "version": "changeset version",
    "db:push": "pnpm --filter api db:push",
    "db:studio": "pnpm --filter api db:studio",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "dev:postgres": "docker compose up -d --wait && pnpm run dev",
    "dev:postgres:down": "docker compose down",
    "dev:postgres:reset": "docker compose down -v && docker compose up -d --wait"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.29.8"
  },
  "dependencies": {
    "every-plugin": "catalog:",
    "everything-dev": "catalog:"
  }
}
