{
  "name": "@everything-dev/auth-plugin",
  "version": "1.2.3",
  "description": "Authentication plugin using Better Auth with NEAR Protocol, passkeys, and more",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@better-auth/api-key": "catalog:",
    "@better-auth/passkey": "catalog:",
    "better-auth": "catalog:",
    "better-near-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "every-plugin": "catalog:",
    "pg": "catalog:",
    "@electric-sql/pglite": "catalog:"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@module-federation/node": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@proj-airi/unplugin-drizzle-orm-migrations": "^0.1.4",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@simplewebauthn/server": "^13.3.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.11.6",
    "dotenv": "^17.2.3",
    "everything-dev": "catalog:",
    "drizzle-kit": "^0.31.8",
    "@scure/base": "catalog:",
    "near-kit": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.17",
    "zephyr-rspack-plugin": "^1.1.0"
  },
  "scripts": {
    "build": "bun run build:types && rspack build",
    "build:types": "tsc -p tsconfig.contract.json",
    "deploy": "bun run build:types && DEPLOY=true rspack build",
    "dev": "bun run build:types && rspack serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  }
}
