{
  "name": "@everything-dev/agents-plugin",
  "version": "0.1.0",
  "description": "NEAR Agent API control plane — custody agents, policies, grants, intents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@near-intents-agent-api/agents-core": "workspace:*",
    "@near-intents-agent-api/contracts": "workspace:*",
    "@near-intents-agent-api/database": "workspace:*",
    "@near-intents-agent-api/outlayer": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@module-federation/node": "catalog:",
    "@module-federation/runtime-tools": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@proj-airi/unplugin-drizzle-orm-migrations": "^0.1.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "catalog:",
    "everything-dev": "catalog:",
    "every-plugin": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "every-plugin build",
    "dev": "every-plugin dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  }
}
