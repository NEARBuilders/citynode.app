{
  "name": "@everything-dev/agents-plugin",
  "version": "0.1.0",
  "description": "NEAR Agent API control plane \u2014 custody agents, policies, grants, intents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    }
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@near-intents-agent-api/agents-core": "workspace:*",
    "@near-intents-agent-api/contracts": "workspace:*",
    "@near-intents-agent-api/database": "workspace:*",
    "@near-intents-agent-api/outlayer": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:",
    "@base-ui/react": "^1.8.0",
    "@orpc/tanstack-query": "catalog:",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "every-plugin": "catalog:",
    "everything-dev": "catalog:",
    "framer-motion": "^12.37.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@module-federation/node": "catalog:",
    "@module-federation/runtime-tools": "catalog:",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@proj-airi/unplugin-drizzle-orm-migrations": "^0.1.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "catalog:",
    "everything-dev": "catalog:",
    "every-plugin": "catalog:",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "catalog:",
    "@module-federation/enhanced": "catalog:",
    "@module-federation/rsbuild-plugin": "catalog:",
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/router-plugin": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "^4.1.17",
    "shadcn": "^4.21.0"
  },
  "scripts": {
    "build": "every-plugin build",
    "dev": "every-plugin dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json"
  }
}
