{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "paths": {
      "every-plugin": ["../every-plugin/src/index.ts"],
      "every-plugin/effect": ["../every-plugin/src/effect.ts"],
      "every-plugin/orpc": ["../every-plugin/src/orpc.ts"],
      "every-plugin/orpc/openapi": ["../every-plugin/src/orpc-openapi.ts"],
      "every-plugin/zod": ["../every-plugin/src/zod.ts"],
      "every-plugin/zod/v4/core": ["../every-plugin/src/zod-core.ts"],
      "every-plugin/runtime": ["../every-plugin/src/runtime/index.ts"],
      "every-plugin/normalize": ["../every-plugin/src/runtime/services/normalize.ts"],
      "every-plugin/testing": ["../every-plugin/src/testing/index.ts"],
      "every-plugin/errors": ["../every-plugin/src/errors.ts"],
      "every-plugin/types": ["../every-plugin/src/types.ts"],
      "every-plugin/build/rspack": ["../every-plugin/src/build/rspack/index.ts"]
    },
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowImportingTsExtensions": true,
    "outDir": "./dist",
    "rootDir": "..",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "../every-plugin/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
