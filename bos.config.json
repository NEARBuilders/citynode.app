      "ssr": "https://elliot-braem-6371-ui-everything-dev-nearbuilders-714d79aa3-ze.zephyrcloud.app",
      "integrity": "sha384-OVw+BstsmnnpPx7Z8BOLESTvcfHbujC/DSQjsEa8GZwBimwkOZRvGCRi24AxNRvq",
