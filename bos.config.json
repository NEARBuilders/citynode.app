{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-7253-host-everything-dev-nearbuilder-aa7d0803c-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7248-ui-everything-dev-nearbuilders-3ca152b89-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7252-ui-everything-dev-nearbuilders-cf9ebe900-ze.zephyrcloud.app",
      "integrity": "sha384-YIdODKfCUjfFZe6M/QaXxylOp6Skko79Rw0CSUi51VTU5aWGCWa0q45M8ftORaOE",
      "ssrIntegrity": "sha384-Iz+Xgf2eA5DAVSP052AvrLw9I9V1eA1PTiMkc79BF+F5uKB4q3ATgyRCx5600guP"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7251-api-everything-dev-nearbuilders-4d144331e-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-g5kMC6dA5l7l9NBq2U5yWgntreOEqT4+ifIH7a6RMC2JSj6tIuGPG6Xq3ZIAPUAi"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "secrets": [
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          },
          "subAccount": {
            "mainnet": {
              "parentAccount": "dev.everything.near",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            },
            "testnet": {
              "parentAccount": "dev.allthethings.testnet",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            }
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-7250-everything-dev-apps-plugin-ever-5d7ad5daa-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ],
      "integrity": "sha384-ehJsiIaaGQb5NjyNKWKS1+4ct479UK+n7MGaB6ZVdOsPSZd7hklMLZcIX5EkXECK"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-7249-every-plugin-template-everythin-85724dd94-ze.zephyrcloud.app",
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "integrity": "sha384-7LAf3x/t4S0nQI0l0rtuvPzpJC81tAHljZOpa1Bc3Lr5pma9jEaM/eClDCvWpnVK"
    }
  }
}
