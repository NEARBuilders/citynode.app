      "production": "https://elliot-braem-6326-host-everything-dev-nearbuilder-7ea95bca8-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-KN8wEV+I4q3isAEldPliyNeHGIwc5l7lTOsz7q0DpP+eEsvIebYw4RiOOE2YwlRX"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6321-ui-everything-dev-nearbuilders-489240a11-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6325-ui-everything-dev-nearbuilders-b6e402e56-ze.zephyrcloud.app",
      "integrity": "sha384-6uwKw7RM/BtVyIs8iaAMc6IGuD0lzPwdAMmA18RcmVSOUBiYS11gqHM8h4wqnSYc",
