      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ],
      "integrity": "sha384-d8rrzi8hs5o1edB0Y4/Q5Gx+8u0zcRgGyqCzAOPgtEXskIcZjvvvBKHXoiq5YIz9"
