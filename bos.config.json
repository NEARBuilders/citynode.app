    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6361-ui-everything-dev-nearbuilders-740d4612a-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6365-ui-everything-dev-nearbuilders-6ecf3527d-ze.zephyrcloud.app",
      "integrity": "sha384-OVw+BstsmnnpPx7Z8BOLESTvcfHbujC/DSQjsEa8GZwBimwkOZRvGCRi24AxNRvq",
