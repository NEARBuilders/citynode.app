{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-6183-host-everything-dev-nearbuilder-e0732c982-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6178-ui-everything-dev-nearbuilders-f2efacfea-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6182-ui-everything-dev-nearbuilders-6e5f525bd-ze.zephyrcloud.app",
      "integrity": "sha384-5iv0aB87QKy+iZ6gLphfuzhG6P+QypBodRpIyM4oDYwEexNg4agEa+EXfJtYcwLu",
      "ssrIntegrity": "sha384-mI6kM8jTv07rFxvYK8h9JGRL3klOUZsXLC16mFZVWvwdb/QLodRtUhlIgoMOlUdP"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6181-api-everything-dev-nearbuilders-196ca0043-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-6180-everything-dev-apps-plugin-ever-e81d7e677-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "integrity": "sha384-nghyrpyaEdNhfWr+mQOt2LC2ScT6beF0LMh1AcXfyCXXGkO6MDs5dG3qMpNTywAY"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-6179-every-plugin-template-everythin-09dbbf9f1-ze.zephyrcloud.app",
      "integrity": "sha384-A4UpfE8lFBuOd+zJTOT8M/Nv5Il8rm4XMJN+BH+IguFp6rs7ZMLx+D2JO8kswjhm"
    }
  }
}
