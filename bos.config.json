{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5504-host-everything-dev-nearbuilder-b377f81a4-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-1eVysJ6IN57vxS7hf6ZgoHqKtKlq9LjB3OGA3q9a37XoPVSlQ3DvSp+yOZnHyqDN"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5499-ui-everything-dev-nearbuilders-eece95bf5-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5500-ui-everything-dev-nearbuilders-ea230a5f7-ze.zephyrcloud.app",
      "integrity": "sha384-O7vtFOQMnRG1vaU0sfaegNESKJwoE/lz9zwRYsqswtTUISws8yiB4OrnMTBIylGA",
      "ssrIntegrity": "sha384-FSoe/w+wmQa2gRXQM651zQC7M7fGzsYZoN3tY9PSp/RjUuVwYSJCjkh04vEhTHCI"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5501-api-everything-dev-nearbuilders-fd352df51-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-w4pCKJt6XuXd0q71wH/Q82y7VvyPChAIph8D+QfKIKs/ya5pYxfKc9EW9stvdylm"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-5502-everything-dev-apps-plugin-ever-f61d92434-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ]
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-5503-every-plugin-template-everythin-0c489edcb-ze.zephyrcloud.app"
    }
  }
}
