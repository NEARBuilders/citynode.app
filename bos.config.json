{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4803-host-everything-dev-nearbuilder-561ed3d25-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-on9j7IIy8QEnKz1DgwnVf25yUV/XEnQHM/LWTs0LMVOPOZJNqP0SLY0hRQNmFDl8"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4797-ui-everything-dev-nearbuilders-cf2fdaa1f-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4798-ui-everything-dev-nearbuilders-b432187da-ze.zephyrcloud.app",
      "integrity": "sha384-zgupbReMggm6Wtzl8NJWrLZXOwF+OORXa8TkvMkO/NrHzRZzU3EXyeZVTMlEk8g4",
      "ssrIntegrity": "sha384-uPEwFJlDO5hwCwM2ukmXAqMWi1RsPusc0PeSLgLh5ySLFtrAbnHTWo60ANKJfNwI"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4799-api-everything-dev-nearbuilders-22f73e0cd-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-gdDKeQ++6oHEb9Z6GSHg7Z3RkXbtsoiv0AUbd2bfq/L4ZvdHHhpQc73ohyUxBoQS"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4800-everything-dev-apps-plugin-ever-4d8527cf7-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-AGu+T4ppIoDNADA7jGFPSZF5pJlJZCRb39xGzYFfGbpG8qIglQOfvim7je/uLP8B"
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4801-everything-dev-projects-plugin--5476e2e98-ze.zephyrcloud.app",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ],
      "integrity": "sha384-xkIBkvIV7uO2JwsErv+Gab+TUE75Nqek0Ue6fsCQ70RyiPTqWK1kf4JfnlZdMYhB"
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4802-every-plugin-settings-everythin-ed84be4aa-ze.zephyrcloud.app",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ],
      "integrity": "sha384-sR0VFDcjMiq7rcsF62ZNN9zFGh745nFyBLl34AkTBIZmk6t4yoO29KmIMwuQUmJg"
    }
  }
}
