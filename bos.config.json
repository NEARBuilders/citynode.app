{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5700-host-everything-dev-nearbuilder-ec407975c-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-GEBCWMhT7G1ed+MIJcDVHAhjqFcfUBsuY6AXlP8aLgHEWqZyGCMMWKTvaBorqkE1"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5695-ui-everything-dev-nearbuilders-18925887a-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5696-ui-everything-dev-nearbuilders-556fa1710-ze.zephyrcloud.app",
      "integrity": "sha384-5iv0aB87QKy+iZ6gLphfuzhG6P+QypBodRpIyM4oDYwEexNg4agEa+EXfJtYcwLu",
