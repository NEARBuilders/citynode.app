{
  "account": "v1.citynode.near",
  "domain": "citynode.app",
  "title": "City Nodes",
  "description": "Decentralized city nodes on NEAR — each city is a tenant with its own validator pool you can stake to.",
  "repository": "https://github.com/NEARBuilders/citynode.app",
  "staging": {
    "domain": "testnet.citynode.app",
    "account": "v1.citynode.testnet"
  },
  "ci": {
    "image": "ghcr.io/nearbuilders/citynode.app",
    "railway": {
      "service": "app"
    }
  },
  "cdn": {
    "origin": "https://cdn.everything.dev"
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/host/",
      "secrets": [
        "CORS_ORIGIN",
        "CSP_STRICT"
      ],
      "pin": {
        "integrity": "sha384-3G0YEcF9Hn4G5Mn3PEJFDu+Yug/Q94hIC5uQqUa9saSQPe9mxHr9VTy+510nWToS",
        "manifest": "versions/9ce1dbca03eb7cb3.json"
      }
    },
    "ui": {
      "development": "local:ui",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/ui/",
      "ssr": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/ui/ssr/",
      "ssrIntegrity": "sha384-wZQZQeHroCp/K9NwNQ+8ZptnGoKwI0z9oR7I+mjcQ8aGg/ADpky3rb2fJYtE5oht",
      "pin": {
        "integrity": "sha384-ZIJ0zHgs9E7Gqm3AI6Ene/gVfK3YmjtXjxBRjKXH42RmUKoys30unWsLTfR5CIFN",
        "manifest": "versions/04cef43170edb230.json"
      }
    },
    "api": {
      "development": "local:api",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/api/",
      "variables": {
        "platformAccount": "v1.citynode.near",
        "gatewayDomains": "citynode.app,testnet.citynode.app",
        "domain": "citynode.app",
        "repository": "https://github.com/NEARBuilders/citynode.app"
      },
      "secrets": [
        "API_DATABASE_URL",
        "LUMA_CALENDAR_API_KEYS"
      ],
      "pin": {
        "integrity": "sha384-5p9afbG86Ow2DVKR5uCmii4axmQpi/b7Z7Fy4UC7aPE/8PdkSbUUIffnomlsmN/b",
        "manifest": "versions/3c46c2745a93dacd.json"
      }
    },
    "auth": {
      "name": "@everything-dev/auth-plugin",
      "development": "local:plugins/auth",
      "ui": {
        "name": "_everything_dev_auth_plugin",
        "development": "local:plugins/auth/ui",
        "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/auth-ui/",
        "ssr": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/auth-ui/ssr/",
        "ssrIntegrity": "sha384-z+dBTmmylC/qBxv4WnKPfCDN8GfqoaFlcqme1ZUcRcAifHzQoY8lrDYNZlqfj60f",
        "pin": {
          "integrity": "sha384-B6fOj1j/OvXVhspxeYWlmL/e/hD3pycZCAMwxYO9TIkdLLVLBHgwS45yBwkXdXdM",
          "manifest": "versions/c26d7ac3a47ade20.json"
        }
      },
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/auth/",
      "secrets": [
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_SECRET",
        "FASTNEAR_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "RESEND_API_KEY",
        "NEAR_RELAYER_PRIVATE_KEY_MAINNET",
        "NEAR_RELAYER_PRIVATE_KEY_TESTNET"
      ],
      "variables": {
        "organizationMembershipLimit": 1000,
        "deviceLink": {
          "clientId": "citynode-web"
        },
        "passkey": {
          "rpID": "citynode.app",
          "rpName": "City Nodes",
          "gatewayOrigins": {
            "mainnet": [
              "https://citynode.app"
            ],
            "testnet": [
              "https://testnet.citynode.app"
            ]
          }
        },
        "socialProviders": {
          "github": {},
          "google": {}
        },
        "siwn": {
          "recipients": {
            "mainnet": "v1.citynode.near",
            "testnet": "v1.citynode.testnet"
          },
          "relayer": {
            "mainnet": {
              "whitelistedContracts": [
                "v1.citynode.near",
                "dev.everything.near"
              ],
              "maxGasPerTransaction": "400000000000000",
              "maxDepositPerTransaction": "0"
            },
            "testnet": {
              "whitelistedContracts": [
                "v1.citynode.testnet",
                "dev.allthethings.testnet"
              ],
              "maxGasPerTransaction": "400000000000000",
              "maxDepositPerTransaction": "0"
            }
          },
          "sessionGasKey": {
            "mainnet": {
              "receiverId": "dev.everything.near",
              "methodNames": [
                "__fastdata_kv"
              ]
            },
            "testnet": {
              "receiverId": "dev.allthethings.testnet",
              "methodNames": [
                "__fastdata_kv"
              ]
            }
          }
        }
      },
      "pin": {
        "integrity": "sha384-ejXojEE9PcGaRKxruBNLYWf0H0mL0qZav0VQH2nwZjotrqyxQhvOZyrqYEpOCSJM",
        "manifest": "versions/bf9fca1e22005c92.json"
      }
    }
  },
  "starter": {
    "exclude": [
      "_public/explore.tsx",
      "_public/stake.tsx",
      "_public/n/**",
      "_public/$accountId.tsx",
      "_public/$accountId/**",
      "_public/activity/**",
      "_authenticated/_dashboard/dashboard/node/**",
      "_authenticated/_dashboard/nodes/**",
      "_authenticated/_dashboard/tenant.*",
      "_authenticated/_dashboard/discover.tsx",
      "_authenticated/_dashboard/apply.tsx",
      "_authenticated/_dashboard/prototype-staking-poc.tsx",
      "_authenticated/onboarding/**",
      "_admin/_dashboard/_dashboard/admin/nodes/**",
      "_admin/_dashboard/_dashboard/admin/proposals/**",
      "_admin/_dashboard/_dashboard/admin/tenants/**",
      "_admin/_dashboard/_dashboard/admin/relayer.tsx",
      "_admin/_dashboard/_dashboard/admin/organizations.tsx"
    ]
  },
  "plugins": {
    "template": {
      "development": "local:plugins/_template",
      "variables": {},
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/template/",
      "pin": {
        "integrity": "sha384-8ko3uryp4pXDT/eujCE/W6GIo0qW0MK0BSUPHdCOVAdXvF/TJswlMvlFaTOB+056",
        "manifest": "versions/cccc82bd356d35f9.json"
      }
    },
    "registry": {
      "development": "local:plugins/registry",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/registry/",
      "pin": {
        "integrity": "sha384-ZoithhMlEqhKfc+c9KGDmvhFerz0ZnaeGdLln64YQMD8/LWhXWNdYg5jppyZ+dso",
        "manifest": "versions/309a65a9735d13e7.json"
      }
    },
    "proposals": {
      "development": "local:plugins/proposals",
      "variables": {
        "privatePluginIds": []
      },
      "secrets": [
        "PROPOSALS_DATABASE_URL"
      ],
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/proposals/",
      "pin": {
        "integrity": "sha384-Ss/yZWG3aPkZSHPhlS7Mp7zhetmQDrXn7A4oLb5bgyDSNZ+xQxSjHKiY22sCN8eM",
        "manifest": "versions/26185da62e5a5938.json"
      }
    },
    "votes": {
      "development": "local:plugins/votes",
      "variables": {},
      "secrets": [
        "VOTES_DATABASE_URL"
      ],
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/votes/",
      "pin": {
        "integrity": "sha384-aqrLImr+x/QFblr+sYQ4SRTmDB1/4vDFiXQ+BJaN3hbNsfFSQ4ShuBbOY34reKNy",
        "manifest": "versions/527b68be3f7190eb.json"
      }
    }
  }
}
