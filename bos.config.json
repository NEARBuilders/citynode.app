{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-7211-host-everything-dev-nearbuilder-e1d00ccbc-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-dk3khNjmNtsT1STjrPZNK7f+rkLeJPXRX5MLu93umVDWziShjiV/TfPSPFdbE41B"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7206-ui-everything-dev-nearbuilders-7ed78a885-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7210-ui-everything-dev-nearbuilders-019f1f015-ze.zephyrcloud.app",
      "integrity": "sha384-MJnOZutq3/aKjALFjBRthKqO5UuZgdmLXrnxiUI2BBPAxa2EP+RdU+MMPZo12zs7",
      "ssrIntegrity": "sha384-bwT3JflVXJM+DZ7k57W/iTgtfjB7hAvmMdqb6NYBS6R3Uituo7ebvoA9jZ+OvTQv"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7208-api-everything-dev-nearbuilders-c0b8d94f4-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-qfrl1n6JTPhZA4EMY+20EP4GfBL45RlqKHTWdPeMVviLFz52R165UJ7xTKfoNAl8"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "secrets": [
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          },
          "subAccount": {
            "mainnet": {
              "parentAccount": "dev.everything.near",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            },
            "testnet": {
              "parentAccount": "dev.allthethings.testnet",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            }
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-7209-everything-dev-apps-plugin-ever-03ab3e475-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ],
      "integrity": "sha384-ehJsiIaaGQb5NjyNKWKS1+4ct479UK+n7MGaB6ZVdOsPSZd7hklMLZcIX5EkXECK"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-7207-every-plugin-template-everythin-83e5b1e84-ze.zephyrcloud.app",
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "integrity": "sha384-7LAf3x/t4S0nQI0l0rtuvPzpJC81tAHljZOpa1Bc3Lr5pma9jEaM/eClDCvWpnVK"
    }
  }
}
