{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-6756-host-everything-dev-nearbuilder-a990e010c-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6751-ui-everything-dev-nearbuilders-10ed38540-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6755-ui-everything-dev-nearbuilders-01d155d65-ze.zephyrcloud.app",
      "integrity": "sha384-1W2ubeM6je9yiBwZq1qvWw0DGD87AY4pA8EBBmq7Ch3OXqORQN7IAsJRI7viOOV5",
      "ssrIntegrity": "sha384-9WGa/zY7j5tTqrfojlKj25L8+0K37/3B6skL2Sw0OyMCnmb7lyQ/wM0zDL6z/sVr"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6754-api-everything-dev-nearbuilders-cd66f56a7-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-6753-everything-dev-apps-plugin-ever-4fe51220f-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ]
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-6752-every-plugin-template-everythin-6ac036a86-ze.zephyrcloud.app"
    }
  }
}
