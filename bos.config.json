    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-6374-every-plugin-template-everythin-8fcf7ea35-ze.zephyrcloud.app",
      "integrity": "sha384-+gttqiNLeC8ikMzRaBfhfG7NCBPAbS/vzmf9IOAmqMqnMxGn2ooaRFGD1wDrJA1L"
    }
  }
