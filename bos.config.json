{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5540-host-everything-dev-nearbuilder-8b1063f10-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-huPB7x7tmHNRPtRlhso62tR3DSmG+s3kj/uHEnWiKXn98oEwKa9ilrwHAZEeLjU9"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5535-ui-everything-dev-nearbuilders-02898d954-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5536-ui-everything-dev-nearbuilders-06cc637e7-ze.zephyrcloud.app",
      "integrity": "sha384-O7vtFOQMnRG1vaU0sfaegNESKJwoE/lz9zwRYsqswtTUISws8yiB4OrnMTBIylGA",
      "ssrIntegrity": "sha384-FSoe/w+wmQa2gRXQM651zQC7M7fGzsYZoN3tY9PSp/RjUuVwYSJCjkh04vEhTHCI"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5537-api-everything-dev-nearbuilders-84fe46ea5-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-aeygj2FGNJ5IJMow5+o0c90nNl1YEZ4MI7TUsDWrcCLR+YUblveVVx3QM7PbX0mQ"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-5538-everything-dev-apps-plugin-ever-506815daf-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-y5as26pVYL/eEMFqvH1L4JOZ6sNaE/WOpg3OPhFfzU6OYa1lbKFNZw6zn5Mk/0dU"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-5539-every-plugin-template-everythin-9bd178276-ze.zephyrcloud.app",
      "integrity": "sha384-MGQezBEycbCxFut2fkK1qjE4k35BXVCb3er5or8T+XeP7Oing8vq178ByumqA7on"
    }
  }
}
