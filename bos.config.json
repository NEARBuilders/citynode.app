      "integrity": "sha384-7Z56EVQczp9UDc2Y7VtpT0SBiF18S1mRzejH6u3HU/GRkALau+FbFpW1O5qpwmJt"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-6804-every-plugin-template-everythin-9200ee1fe-ze.zephyrcloud.app",
      "integrity": "sha384-G4yrA0f+4PEF/lNxB5GIZO8azVCVFne5OHlVNrzWYVnTVczbChroAxZ//DU2uzmT"
    }
  }
