{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-6213-host-everything-dev-nearbuilder-da54041bd-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-oy4TypkCyYHg10gsY16s4tYSVybLbIMvoJRsDdcYZvq9UFZH1qt3f2e1VTnYhNW4"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6208-ui-everything-dev-nearbuilders-398a14630-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6212-ui-everything-dev-nearbuilders-e295cfbd9-ze.zephyrcloud.app",
      "integrity": "sha384-5iv0aB87QKy+iZ6gLphfuzhG6P+QypBodRpIyM4oDYwEexNg4agEa+EXfJtYcwLu",
