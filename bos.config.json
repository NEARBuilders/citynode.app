      "ssr": "https://elliot-braem-6176-ui-everything-dev-nearbuilders-db04eb1b0-ze.zephyrcloud.app",
      "integrity": "sha384-5iv0aB87QKy+iZ6gLphfuzhG6P+QypBodRpIyM4oDYwEexNg4agEa+EXfJtYcwLu",
