{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-7229-host-everything-dev-nearbuilder-12f519692-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7224-ui-everything-dev-nearbuilders-db53b43ab-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7228-ui-everything-dev-nearbuilders-ecfd9ec6d-ze.zephyrcloud.app",
      "integrity": "sha384-QZNCvNWL0GI5M7/g4b5ooXHf8Bk69ARP/5m1HMKtFq9JtsqeBw75AtyY0cONnxGJ",
      "ssrIntegrity": "sha384-X1jSDaTYmEoCB0sORbicejIdYNBW8eBSTqsFy7zTjYls3F0zc7rLJ7G/o64OANY8"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7226-api-everything-dev-nearbuilders-5dd9000cc-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-qfrl1n6JTPhZA4EMY+20EP4GfBL45RlqKHTWdPeMVviLFz52R165UJ7xTKfoNAl8"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "secrets": [
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          },
          "subAccount": {
            "mainnet": {
              "parentAccount": "dev.everything.near",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            },
            "testnet": {
              "parentAccount": "dev.allthethings.testnet",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            }
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-7227-everything-dev-apps-plugin-ever-86362979e-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ],
      "integrity": "sha384-ehJsiIaaGQb5NjyNKWKS1+4ct479UK+n7MGaB6ZVdOsPSZd7hklMLZcIX5EkXECK"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-7225-every-plugin-template-everythin-e8c2fed85-ze.zephyrcloud.app",
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "integrity": "sha384-7LAf3x/t4S0nQI0l0rtuvPzpJC81tAHljZOpa1Bc3Lr5pma9jEaM/eClDCvWpnVK"
    }
  }
}
