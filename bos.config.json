{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-6378-host-everything-dev-nearbuilder-1c7d50e84-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-Fn7prlc70hP21ZycC7bd8mFmowgTTURYp6+eO6mRzE6lY3rfqTrWS97cBl+OFTdK"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6373-ui-everything-dev-nearbuilders-31ecde507-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6377-ui-everything-dev-nearbuilders-61a5fcf11-ze.zephyrcloud.app",
      "integrity": "sha384-OVw+BstsmnnpPx7Z8BOLESTvcfHbujC/DSQjsEa8GZwBimwkOZRvGCRi24AxNRvq",
      "ssrIntegrity": "sha384-gJkSP0zObOChH4Mb/p2UL1LoTzKpU6SAKax8IQk06PpcaojM4t2DYnitshlbarpE"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6375-api-everything-dev-nearbuilders-8e336ce0a-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-DDJm5+xPdFyx1wZybDgCUiBEfo/Ew8EjYACRvHyaDJJy/O5lDGulPTBlNcaQvHXV"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-6376-everything-dev-apps-plugin-ever-d31ad760f-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
