{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-6808-host-everything-dev-nearbuilder-568d4fc79-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6803-ui-everything-dev-nearbuilders-f0f130771-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6807-ui-everything-dev-nearbuilders-42687d6d3-ze.zephyrcloud.app",
      "integrity": "sha384-j6k8NqckPbc1Y2OxpGJbAD7LRcNMBHLnBsAB3mdY9NFiqE1Moi3r/OQBMmbTb4v+",
      "ssrIntegrity": "sha384-QYntTlvychH5E+j62yaQ4YB14BpId7X5BzMQj12XPh2uFOqunZNnEEBB1e3t9oXq"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6806-api-everything-dev-nearbuilders-bfb9c5574-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-wmNh/AY1tslut3nnhnQZId20LkpTCJSPvlDFW9MMz5bnisNXz8tx0qPk5eW95mIn"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-6805-everything-dev-apps-plugin-ever-d8d286c3b-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
