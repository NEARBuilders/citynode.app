{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4101-host-everything-dev-nearbuilder-2df9894b4-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-BbVAp4qzzrY2J1tHpnM0pcCXH6HkTlgau2KX8JonZGFHlQ3YEhezM3NiRy8x+40Q"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4095-ui-everything-dev-nearbuilders-6e89db2b1-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4096-ui-everything-dev-nearbuilders-d4eba8121-ze.zephyrcloud.app",
      "integrity": "sha384-4f34GCFe6XCRoz4Vqciw6dVx4KaPPvAPILbD0iZdWdjV5lhRREjVMyVY0GIVnVip",
      "ssrIntegrity": "sha384-BlurLh9PhEMtLcEsoitvN6Y629U6hCVAELpwBdj8vfkGZCTvXV8jsKJXETc5MQN8"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4097-api-everything-dev-nearbuilders-e46f3fe15-ze.zephyrcloud.app",
      "integrity": "sha384-1QVKgOG2z5Ouz3Ui3Bj4KeGgZfCBJgxWmwv89Yle85EJ3NcD2Q9iYSC/jrKsX/Y7",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/everything.dev#app.auth"
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4098-everything-dev-apps-plugin-ever-827acf23d-ze.zephyrcloud.app",
      "integrity": "sha384-HxmWBkKKPYgtN3s0/2qAlXMThQbp0Al/KcaS1OxabGtGevjMzOIZARm+YnHTIUPd",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ]
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4099-everything-dev-projects-plugin--b1ded766e-ze.zephyrcloud.app",
      "integrity": "sha384-HbSmv7VBbuGtpfpRQHvx40VSoPIJw81bMIwnd+6jX3U9PpyAMhlhS2eRHQKXxU0y",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ]
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4100-every-plugin-settings-everythin-a2f231969-ze.zephyrcloud.app",
      "integrity": "sha384-VQHIcTRu11j/TD6w0mAkbKKcxgqUuofVzlXD2xgsksXo4lRLCAPPrQAuLKCxej1q",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  },
  "shared": {
    "ui": {
      "effect": {
        "version": "3.21.2",
        "requiredVersion": "^3.21.2",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "zod": {
        "version": "4.3.6",
        "requiredVersion": "^4.3.6",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@orpc/contract": {
        "version": "1.14.3",
        "requiredVersion": "^1.14.3",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-auth": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-near-auth": {
        "version": "1.5.0",
        "requiredVersion": "^1.5.0",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/api-key": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/passkey": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      }
    },
    "plugins": {}
  }
}
