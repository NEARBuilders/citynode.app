{
  "account": "v1.citynode.near",
  "domain": "citynode.app",
  "title": "City Nodes",
  "description": "Decentralized city nodes on NEAR — each city is a tenant with its own validator pool you can stake to.",
  "repository": "https://github.com/NEARBuilders/citynode.app",
  "staging": {
    "domain": "testnet.citynode.app",
    "account": "v1.citynode.testnet"
  },
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/host/",
      "secrets": [
        "CORS_ORIGIN",
        "CSP_STRICT"
      ],
      "integrity": "sha384-wYkRZAiZa/OvazmLzLMkjbE+m7kfoO0+nkOlNAkthjkhzHAMwfkFB4jbpsXTBDrr"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/ui/",
      "ssr": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/ui/ssr/",
      "integrity": "sha384-ytJtmfXQke7d4QJ7Drkj7SRk6Atv7IRw+b/Cm6WLML0XacHH1eLahe5+rgStlTnp",
      "ssrIntegrity": "sha384-wJoIvToiUH4dDH2wwO5dmQVAA8iT4ElWSd3GGsgUqsft0mjNGrE/WK2RxA1XJgnr"
    },
    "api": {
      "development": "local:api",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/api/",
      "variables": {
        "platformAccount": "v1.citynode.near",
        "gatewayDomains": "citynode.app,testnet.citynode.app"
      },
      "secrets": [
        "API_DATABASE_URL",
        "LUMA_CALENDAR_API_KEYS"
      ],
      "integrity": "sha384-OKji1LnFu2CyIdTgYb3VNg4gb1dObRrFTPk2si+Y3I7vxzbLMX7YN36IAU0Al10/"
    },
    "auth": {
      "name": "@everything-dev/auth-plugin",
      "development": "local:plugins/auth",
      "ui": {
        "name": "auth-ui",
        "development": "local:plugins/auth/ui",
        "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/auth-ui/",
        "integrity": "sha384-1b0Cgp7GUwogVIeZq1bImmhMvtotn6VX/GkTsLDXniNayKrM5n0pw5uszTLD3I0v",
        "ssr": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/auth-ui/ssr/",
        "ssrIntegrity": "sha384-g7YMg+cy5nmWvkI0xgT/pWXsYliIhRnmb1UYPFmwMYOhFPw6o13jE+60MHxnVruH"
      },
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/auth/",
      "secrets": [
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "GOOGLE_CLIENT_SECRET",
        "FASTNEAR_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "RESEND_API_KEY",
        "NEAR_RELAYER_PRIVATE_KEY_MAINNET",
        "NEAR_RELAYER_PRIVATE_KEY_TESTNET"
      ],
      "variables": {
        "organizationMembershipLimit": 1000,
        "deviceLink": {
          "clientId": "citynode-web"
        },
        "passkey": {
          "rpID": "citynode.app",
          "rpName": "City Nodes",
          "gatewayOrigins": {
            "mainnet": [
              "https://citynode.app"
            ],
            "testnet": [
              "https://testnet.citynode.app"
            ]
          }
        },
        "socialProviders": {
          "github": {},
          "google": {}
        },
        "siwn": {
          "recipients": {
            "mainnet": "v1.citynode.near",
            "testnet": "v1.citynode.testnet"
          },
          "relayer": {
            "mainnet": {
              "whitelistedContracts": [
                "v1.citynode.near",
                "dev.everything.near"
              ],
              "maxGasPerTransaction": "400000000000000",
              "maxDepositPerTransaction": "0"
            },
            "testnet": {
              "whitelistedContracts": [
                "v1.citynode.testnet",
                "dev.allthethings.testnet"
              ],
              "maxGasPerTransaction": "400000000000000",
              "maxDepositPerTransaction": "0"
            }
          },
          "sessionGasKey": {
            "mainnet": {
              "receiverId": "dev.everything.near",
              "methodNames": [
                "__fastdata_kv"
              ]
            },
            "testnet": {
              "receiverId": "dev.allthethings.testnet",
              "methodNames": [
                "__fastdata_kv"
              ]
            }
          }
        }
      },
      "integrity": "sha384-RvjbukXVXlMN1Ra1Nx9wCBveIUxZCOtxmjGy3MEtKTe7dWZ23Op9DyI+s6kSbonI"
    }
  },
  "plugins": {
    "template": {
      "development": "local:plugins/_template",
      "variables": {},
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/template/",
      "integrity": "sha384-JXL5QTB3ywysV3dVkS1oPYl/P16HAT09MOyBT6gnvMBPbNIn+o9Xqyj68Fu5TEo/"
    },
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/apps/",
      "integrity": "sha384-n3N7mNalqLdaYaopJKSE5Ir9xr65BkqmHRN2IrYVW1Y85YjnPwiXko5DHIf/7YRT"
    },
    "proposals": {
      "development": "local:plugins/proposals",
      "variables": {
        "privatePluginIds": []
      },
      "secrets": [
        "PROPOSALS_DATABASE_URL"
      ],
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/proposals/",
      "integrity": "sha384-zQq34ANaZF7alrDm7zZ7GLi7bIcfum1pVpI3kQo6+qG4MEP7ahLGIeybsw4cp4zV"
    },
    "votes": {
      "development": "local:plugins/votes",
      "variables": {},
      "secrets": [
        "VOTES_DATABASE_URL"
      ],
      "production": "https://cdn.everything.dev/bundles/v1.citynode.near/citynode.app/votes/",
      "integrity": "sha384-Uv58fEFwTHyt2CfnsUkgKhIHrrUbq+kDeI8jzJN1lzzGdtXUQ34FFMQFO/OtY1wz"
    }
  }
}
