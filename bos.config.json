{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4080-host-everything-dev-nearbuilder-3402c0850-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4074-ui-everything-dev-nearbuilders-84ca266f4-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4075-ui-everything-dev-nearbuilders-8b6cad4e7-ze.zephyrcloud.app",
      "integrity": "sha384-j4HCcWeSt2eCkBG28JcM1i1uBQZWCDzae3+eNEWDr78plu6FYiIk8P6r6g3rNB+W",
      "ssrIntegrity": "sha384-rEU7gzsXQg6UYOIYgwcdZGw7ouQgmMC3+L3j3kGNDtLsyWzZ34zyBhGmLX2JY4PE"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4076-api-everything-dev-nearbuilders-30de9c262-ze.zephyrcloud.app",
      "integrity": "sha384-1QVKgOG2z5Ouz3Ui3Bj4KeGgZfCBJgxWmwv89Yle85EJ3NcD2Q9iYSC/jrKsX/Y7",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/everything.dev#app.auth"
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4077-everything-dev-apps-plugin-ever-fde81e6ab-ze.zephyrcloud.app",
      "integrity": "sha384-HxmWBkKKPYgtN3s0/2qAlXMThQbp0Al/KcaS1OxabGtGevjMzOIZARm+YnHTIUPd",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ]
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4078-everything-dev-projects-plugin--f3dbca0cb-ze.zephyrcloud.app",
      "integrity": "sha384-HbSmv7VBbuGtpfpRQHvx40VSoPIJw81bMIwnd+6jX3U9PpyAMhlhS2eRHQKXxU0y",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ]
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4079-every-plugin-settings-everythin-9a50245b2-ze.zephyrcloud.app",
      "integrity": "sha384-VQHIcTRu11j/TD6w0mAkbKKcxgqUuofVzlXD2xgsksXo4lRLCAPPrQAuLKCxej1q",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  },
  "shared": {
    "ui": {
      "effect": {
        "version": "3.21.2",
        "requiredVersion": "^3.21.2",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "zod": {
        "version": "4.3.6",
        "requiredVersion": "^4.3.6",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@orpc/contract": {
        "version": "1.14.3",
        "requiredVersion": "^1.14.3",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-auth": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "better-near-auth": {
        "version": "1.5.0",
        "requiredVersion": "^1.5.0",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/api-key": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      },
      "@better-auth/passkey": {
        "version": "1.6.9",
        "requiredVersion": "^1.6.9",
        "singleton": true,
        "strictVersion": false,
        "shareScope": "default"
      }
    },
    "plugins": {}
  }
}
