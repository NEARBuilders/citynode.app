      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "extends": "bos://auth.everything.near/everything.dev#app.auth"
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4091-everything-dev-apps-plugin-ever-3ad823c50-ze.zephyrcloud.app",
