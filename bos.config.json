{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-7205-host-everything-dev-nearbuilder-a11d36f8d-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-zJzQi5Uz3DJP62IXJS0xAngy5q3QZ921iHvSCD0Ht0JLd1oYAnlK7gCln4WCRNxW"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7200-ui-everything-dev-nearbuilders-0de59e6ce-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7204-ui-everything-dev-nearbuilders-4cf8ebb2c-ze.zephyrcloud.app",
      "integrity": "sha384-++UZ5cYVO0QZ7QH1rYBFnK2st7ZbJM+NbTbERQgF2C4BaNhwKSB2mo2gBx5HZ4RW"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7203-api-everything-dev-nearbuilders-86b7f0d72-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-3zWK667y+rSPSfxU0Nnofk+dqn9lwhqWazQPWFBx7jSsiF9J/NQbHiBGBIu7oPbl"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "secrets": [
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          },
          "subAccount": {
            "mainnet": {
              "parentAccount": "dev.everything.near",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            },
            "testnet": {
              "parentAccount": "dev.allthethings.testnet",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            }
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-7202-everything-dev-apps-plugin-ever-b99db1d73-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**"
      ],
      "integrity": "sha384-Lnr4+/+6i4KZ7lHXQATCM0Gi/ntdJvl7wp+OR00pUVCe/ckBWshDVNEj6auPt1Z+"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-7201-every-plugin-template-everythin-aca40be9d-ze.zephyrcloud.app",
      "secrets": [
        "TEMPLATE_DATABASE_URL"
      ],
      "integrity": "sha384-Ie6DcJTqFrGKSRMZJP0DoMZ8spk/a36GhFsuuVQ/hxxyAqXBxCJkv/I4JduFxTac"
    }
  }
}
