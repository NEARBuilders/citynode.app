{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5142-host-everything-dev-nearbuilder-afc5eebcc-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-1A4kXAXg1xW29UH1Y5dbUnP95QdkiVOBGGL+gVwKdRcG5jZafco6ZUOKe8dqs10I"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5136-ui-everything-dev-nearbuilders-46a63ab52-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5137-ui-everything-dev-nearbuilders-47e8676c8-ze.zephyrcloud.app",
      "integrity": "sha384-S67ERuV8N4UOfPpyYAebyyYhnU0PHd4ujcE/dBGxKmn7gOdxQ8ji9FT8M63BiNbB",
      "ssrIntegrity": "sha384-h5Wjg48Mj42ifSCcn5Bu/A+oGtxRK4WoJtQa+1ezjLmNltLzH5xmqemIaYqRCtoZ"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5138-api-everything-dev-nearbuilders-26a897180-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-gdDKeQ++6oHEb9Z6GSHg7Z3RkXbtsoiv0AUbd2bfq/L4ZvdHHhpQc73ohyUxBoQS"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-5139-everything-dev-apps-plugin-ever-f158fcc0f-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-AGu+T4ppIoDNADA7jGFPSZF5pJlJZCRb39xGzYFfGbpG8qIglQOfvim7je/uLP8B"
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-5140-everything-dev-projects-plugin--406b04e02-ze.zephyrcloud.app",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ],
      "integrity": "sha384-xkIBkvIV7uO2JwsErv+Gab+TUE75Nqek0Ue6fsCQ70RyiPTqWK1kf4JfnlZdMYhB"
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-5141-every-plugin-settings-everythin-5b2bf0ce9-ze.zephyrcloud.app",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ],
      "integrity": "sha384-sR0VFDcjMiq7rcsF62ZNN9zFGh745nFyBLl34AkTBIZmk6t4yoO29KmIMwuQUmJg"
    }
  }
}
