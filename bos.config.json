    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6324-api-everything-dev-nearbuilders-d85a880fe-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-BuqPYvzAxkvzn8WZluubrHMjTHlf17rngaqZgipgQIsHUvcPhsbvVNEbbWjMgQUM"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
