              "maxGasPerTransaction": "400000000000000",
              "maxDepositPerTransaction": "0"
            }
          },
          "sessionGasKey": {
            "mainnet": {
              "receiverId": "dev.everything.near",
              "methodNames": [
                "__fastdata_kv"
              ]
            },
            "testnet": {
              "receiverId": "dev.allthethings.testnet",
              "methodNames": [
                "__fastdata_kv"
              ]
            }
          }
        }
      },
      "pin": {
        "integrity": "sha384-bKZMAFl/wgtOCEllhgaOxA9awjRVhlaedvjvPP6xyUeFgLr64KUMHgcQCLxF8J7R",
        "manifest": "versions/20544eb3aa73609d.json"
