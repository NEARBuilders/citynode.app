{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4629-host-everything-dev-nearbuilder-e33a04fd4-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4623-ui-everything-dev-nearbuilders-0df9a7268-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4624-ui-everything-dev-nearbuilders-719534aeb-ze.zephyrcloud.app",
      "integrity": "sha384-xcHQoTCveKnNn23zeu5ILtZayWkQT3/Xg3EE1hG/8M8MJEGwuZFfdVFtNNv97k1r"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4625-api-everything-dev-nearbuilders-4a6b39959-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "name": "everything-dev_auth-plugin",
      "development": "local:plugins/auth",
      "production": "https://elliot-braem-4596-everything-dev-auth-plugin-bett-5c7464d90-ze.zephyrcloud.app",
      "integrity": "sha384-hdiTtgW15RyAVkpNdgNxQxKP3xOkMs2jJ27O53l1zEi++nghcPFn8QZQb9avuLMe",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "Better NEAR Auth"
        },
        "siwn": {
          "recipients": {
            "mainnet": "auth.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      },
      "secrets": [
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "FASTNEAR_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "NEAR_RELAYER_PRIVATE_KEY",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "shared": {
        "better-auth": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "better-near-auth": {
          "version": "1.6.1",
          "requiredVersion": "^1.5.0",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/api-key": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/passkey": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4626-everything-dev-apps-plugin-ever-a4afbd38d-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-AGu+T4ppIoDNADA7jGFPSZF5pJlJZCRb39xGzYFfGbpG8qIglQOfvim7je/uLP8B"
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4627-everything-dev-projects-plugin--b87ade27c-ze.zephyrcloud.app",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ]
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4628-every-plugin-settings-everythin-681a28ed5-ze.zephyrcloud.app",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  }
}
