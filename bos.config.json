{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-4603-host-everything-dev-nearbuilder-7523d9682-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-GroB2I73vwUByP6bln24s6AremT5nagHA3T15qrs82IhfDl8fhuQgBRwit7CJk5C"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-4597-ui-everything-dev-nearbuilders-1b48c87fb-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-4598-ui-everything-dev-nearbuilders-5584ff3a1-ze.zephyrcloud.app",
      "integrity": "sha384-jgZFiDZy9xZcBHHLsd6YorJJjXzU8CRdE3ttLL53jqal1wRSqUpvKhe9t2zpkjdB",
      "ssrIntegrity": "sha384-jU04H30nra6DnTL5xGeW9h1FFThAAFKj2/x2bb00QB0VfRP4V9CabGQwENlt7DEh"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-4599-api-everything-dev-nearbuilders-f6ea0f3c0-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ]
    },
    "auth": {
      "name": "everything-dev_auth-plugin",
      "development": "local:plugins/auth",
      "production": "https://elliot-braem-4596-everything-dev-auth-plugin-bett-5c7464d90-ze.zephyrcloud.app",
      "integrity": "sha384-hdiTtgW15RyAVkpNdgNxQxKP3xOkMs2jJ27O53l1zEi++nghcPFn8QZQb9avuLMe",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "Better NEAR Auth"
        },
        "siwn": {
          "recipients": {
            "mainnet": "auth.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      },
      "secrets": [
        "AUTH_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "GITHUB_CLIENT_SECRET",
        "FASTNEAR_API_KEY",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_PHONE_NUMBER",
        "NEAR_RELAYER_PRIVATE_KEY",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET",
        "NEAR_SUB_ACCOUNT_PARENT_KEY_TESTNET"
      ],
      "shared": {
        "better-auth": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "better-near-auth": {
          "version": "1.5.0",
          "requiredVersion": "^1.5.0",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/api-key": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        },
        "@better-auth/passkey": {
          "version": "1.6.9",
          "requiredVersion": "^1.6.9",
          "singleton": true,
          "strictVersion": false,
          "shareScope": "default"
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-4600-everything-dev-apps-plugin-ever-386b3354c-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ]
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-4601-everything-dev-projects-plugin--8da3ab04b-ze.zephyrcloud.app",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
        }
      ],
      "integrity": "sha384-1rhekdbGRGW4GmgMrVI5baW8dtePnUSxLvlDOFvMR76XXwZf4jE5gV90ahmLaWII"
    },
    "settings": {
      "development": "local:plugins/settings",
      "production": "https://elliot-braem-4602-every-plugin-settings-everythin-ab55dcaa5-ze.zephyrcloud.app",
      "integrity": "sha384-sWkPVbWAsE6Ui6SzKDt1iwcZhVFVs8mSh9syh3g6fVVdS5x0OWKjRIUOyazeyu7Q",
      "routes": [
        "ui/src/routes/_layout/_authenticated/settings.tsx"
      ],
      "sidebar": [
        {
          "icon": "Settings",
          "label": "settings"
        }
      ]
    }
  }
}
