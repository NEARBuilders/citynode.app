    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6211-api-everything-dev-nearbuilders-ec339d5c1-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-bqLl97Es9Sncp7K+LAowiWIOsbMyILG7Oey7uPtx6cW7xvDh4u9pasEokyeK9ST8"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
