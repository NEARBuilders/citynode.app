      "production": "https://elliot-braem-7028-host-everything-dev-nearbuilder-8f56a3ce6-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-zJzQi5Uz3DJP62IXJS0xAngy5q3QZ921iHvSCD0Ht0JLd1oYAnlK7gCln4WCRNxW"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7023-ui-everything-dev-nearbuilders-c1a9aaa14-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7027-ui-everything-dev-nearbuilders-942e049fa-ze.zephyrcloud.app",
      "integrity": "sha384-M9rAIwUrdMQMJpSpFCCGoK53MGoM6WCuJYX1JtJY+2xCmVkN+kobjyW2F6WdV6yk",
      "ssrIntegrity": "sha384-s4j2pg/7f4dezaK+oYFglcXHCXG2vPzNKa7aBLWlfwy3/FDIE5CJCYaHSV+a0QBU"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7026-api-everything-dev-nearbuilders-f0db76f1d-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-bGmxkwBPzjw9IPtrWHLneXXrTZMAtpZKixQqWBgnfqDAShuBawUFUvzAsHrxxNcb"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
