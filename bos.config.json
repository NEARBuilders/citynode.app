      "production": "https://elliot-braem-6320-host-everything-dev-nearbuilder-780772ca4-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-VP29KwXnVgnthXu0PCF9zpM0qTjX8aUcZofvq0qTNLR0IGyuBQIbqEZ4NN4x+421"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-6315-ui-everything-dev-nearbuilders-b629fe7a9-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-6319-ui-everything-dev-nearbuilders-c7b50dd2e-ze.zephyrcloud.app",
      "integrity": "sha384-qRFPmGAxkS092JluGLR5F7FmsKyMkTzNf3Z7EYabxqRLtlX5v/mLyf5wq/11+3cG",
