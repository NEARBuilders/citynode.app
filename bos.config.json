{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5347-host-everything-dev-nearbuilder-e9bf858cb-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-OvbigFPwGxlQYblX1JsDNbr/ntka4rPu4vfREhJGplKjpqLbd1FPLvOtMD2bcVSp"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5341-ui-everything-dev-nearbuilders-48507a04e-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5342-ui-everything-dev-nearbuilders-d2d3e4859-ze.zephyrcloud.app",
      "integrity": "sha384-S67ERuV8N4UOfPpyYAebyyYhnU0PHd4ujcE/dBGxKmn7gOdxQ8ji9FT8M63BiNbB",
      "ssrIntegrity": "sha384-h5Wjg48Mj42ifSCcn5Bu/A+oGtxRK4WoJtQa+1ezjLmNltLzH5xmqemIaYqRCtoZ"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5343-api-everything-dev-nearbuilders-7980f8e72-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-szZIZv/L4cbWkal6RRb4ifz941ERUhMxDaqeoftgE1eEIJ3mi7poJBb3eafkmpu4"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-5344-everything-dev-apps-plugin-ever-71aebe62c-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-wKXTvWAAHvluWG8DUBYgY70C/AFq6ey5dJSAdXWJrqCHs+YI4/LvmWpvTM7ri5cT"
    },
    "projects": {
      "development": "local:plugins/projects",
      "production": "https://elliot-braem-5345-everything-dev-projects-plugin--fae8052b1-ze.zephyrcloud.app",
      "secrets": [
        "PROJECTS_DATABASE_URL"
      ],
      "routes": [
        "ui/src/routes/_layout/_authenticated/projects/**"
      ],
      "sidebar": [
        {
          "icon": "FolderKanban",
          "label": "projects"
