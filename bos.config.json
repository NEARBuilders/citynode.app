    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-6317-api-everything-dev-nearbuilders-3e84b3a61-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-5i9q03knib+fs8uWt6tvmO0xSEItMASWP3oOjc9zV9qxYDLOiVaD0tFrLvm4++GP"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
