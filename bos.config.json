{
  "account": "dev.everything.near",
  "domain": "dev.everything.dev",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-5463-host-everything-dev-nearbuilder-f9edbcb6a-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-OvbigFPwGxlQYblX1JsDNbr/ntka4rPu4vfREhJGplKjpqLbd1FPLvOtMD2bcVSp"
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-5458-ui-everything-dev-nearbuilders-de68a635b-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-5459-ui-everything-dev-nearbuilders-7cdf130b0-ze.zephyrcloud.app",
      "integrity": "sha384-QkpFpKlXL4rutNbfgYG31028eMZ4te4lPTKah5+5DEoOU9CEQY4OW2qvLibJvKM0",
      "ssrIntegrity": "sha384-hVya8iRLkf7QqRodwERkT5LYQOqb7RoGOMzuVDYPF7wjtUc7i+B8WCd0erpFiplE"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-5460-api-everything-dev-nearbuilders-096c47b89-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-Gn8tvG3dpI5Hr3S0P9Aedgbb1uHX4eIh9/lyJ0zy/c3/eim/oH1pPem+9eCdaHag"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev",
      "variables": {
        "passkey": {
          "rpID": "everything.dev",
          "rpName": "everything.dev"
        },
        "siwn": {
          "recipients": {
            "mainnet": "dev.everything.near",
            "testnet": "dev.allthethings.testnet"
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-5461-everything-dev-apps-plugin-ever-3e1e00314-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "dev.everything.near"
      },
      "routes": [
        "ui/src/routes/_layout/apps/**",
        "ui/src/routes/_layout/index.tsx"
      ],
      "sidebar": [
        {
          "icon": "Globe",
          "label": "apps",
          "roleRequired": "anon"
        }
      ],
      "integrity": "sha384-wKXTvWAAHvluWG8DUBYgY70C/AFq6ey5dJSAdXWJrqCHs+YI4/LvmWpvTM7ri5cT"
    },
    "template": {
      "development": "local:plugins/_template",
      "production": "https://elliot-braem-5462-every-plugin-template-everythin-e2c0a6b0c-ze.zephyrcloud.app",
      "integrity": "sha384-oSNmnwCyk/SiBf5h6YXRtJw6xDPTrlCy4TnfeXUG4buDN0Xdi56/WM6o1gMb9fOq"
    }
  }
}
