      "secrets": [
        "CORS_ORIGIN",
        "TENANT_WHITELIST",
        "ALLOW_OVERRIDE",
        "ALLOW_UNTRUSTED_SSR",
        "CSP_STRICT"
      ],
      "integrity": "sha384-IBAq/XBNq+Hf1T1ncLpJdyMrZUXNKgHrOcM92gMuo7/QmWn4b9mCOI2LQODEB74O"
    },
    "ui": {
