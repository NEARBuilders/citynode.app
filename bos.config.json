      "ssr": "https://elliot-braem-5630-ui-everything-dev-nearbuilders-a542de964-ze.zephyrcloud.app",
      "integrity": "sha384-Oy+bTw2QZqs/prPIxoagHOj/75BWpvA4iEBGEaXu67iLE9vmSs2mapZDCuh5JbxJ",
