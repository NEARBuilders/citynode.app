      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-xwVUCIfLdO+XCuSeQWscLZfYmidWFBLS75WMRUGNJYNR0mBzsXtKLlBy4wVKZcNu"
