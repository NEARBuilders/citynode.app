{
  "account": "v1.citynode.near",
  "domain": "citynode.app",
  "title": "City Nodes",
  "description": "Decentralized city nodes on NEAR — each city is a tenant with its own validator pool you can stake to.",
  "repository": "https://github.com/nearbuilders/everything-dev",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "host": {
      "development": "local:host",
      "production": "https://elliot-braem-7503-host-everything-dev-nearbuilder-4e76ec8b8-ze.zephyrcloud.app",
      "secrets": [
        "CORS_ORIGIN",
        "CSP_STRICT"
      ]
    },
    "ui": {
      "development": "local:ui",
      "production": "https://elliot-braem-7499-ui-everything-dev-nearbuilders-08902a653-ze.zephyrcloud.app",
      "ssr": "https://elliot-braem-7502-ui-everything-dev-nearbuilders-22dfc7ba1-ze.zephyrcloud.app",
      "integrity": "sha384-AXuub5U3ACzCe0n9sPmtQRubpGztd0lL/1HAO7wvKmXsHoBVmMXpdlGVE321miTn",
      "ssrIntegrity": "sha384-J6f4UgyzBfY6jk07aXRAPv1ylDIfhtPWghDFjnvsWr0SSN/g/pOk/iJsI7gDfEHb"
    },
    "api": {
      "development": "local:api",
      "production": "https://elliot-braem-7501-api-everything-dev-nearbuilders-666d5f436-ze.zephyrcloud.app",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "integrity": "sha384-00BLwWU5KxWWv6kop6rJnBM6DCfzmmC9bAtrHlHFnVBgQ/P3dTzcZonQ+qiklzyd"
    },
    "auth": {
      "extends": "bos://auth.everything.near/auth.everything.dev#app.auth",
      "secrets": [
        "NEAR_SUB_ACCOUNT_PARENT_KEY_MAINNET"
      ],
      "variables": {
        "passkey": {
          "rpID": "citynode.app",
          "rpName": "City Nodes"
        },
        "siwn": {
          "recipients": {
            "mainnet": "v1.citynode.near",
            "testnet": "v1.citynode.testnet"
          },
          "relayer": {
            "mainnet": {
              "whitelistedContracts": [
                "v1.citynode.near"
              ],
              "maxGasPerTransaction": "300000000000000",
              "maxDepositPerTransaction": "0"
            },
            "testnet": {
              "whitelistedContracts": [
                "v1.citynode.testnet"
              ],
              "maxGasPerTransaction": "300000000000000",
              "maxDepositPerTransaction": "0"
            }
          },
          "subAccount": {
            "mainnet": {
              "parentAccount": "v1.citynode.near",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            },
            "testnet": {
              "parentAccount": "v1.citynode.testnet",
              "parentHasFullAccess": true,
              "minDeposit": "0.1 NEAR"
            }
          }
        }
      }
    }
  },
  "plugins": {
    "apps": {
      "development": "local:plugins/apps",
      "production": "https://elliot-braem-7500-everything-dev-apps-plugin-ever-4759fcff0-ze.zephyrcloud.app",
      "variables": {
        "registryNamespace": "v1.citynode.near"
      },
      "integrity": "sha384-keO9JeWLzGjeKM6GWu0bkFX9MBsaxFgEdtftMedxIZBHFESdwcX2KGiuG/hOxelC"
    }
